# PlayBron API — namuna. `.env` ga ko'chiring va to'ldiring. `.env` git'ga tushmaydi.

ENV=local
DEBUG=true

# ── Ma'lumotlar bazasi ────────────────────────────────────────────────────
# Ilova RLS ostidagi rol bilan ulanadi
DATABASE_URL=postgresql+asyncpg://playbron_app:app@localhost:5432/playbron
# Migratsiya va seed — egasi roli, RLS'ni chetlab o'tadi
DIRECT_URL=postgresql+psycopg://playbron:playbron@localhost:5432/playbron
# Super admin cross-tenant o'qishi — BYPASSRLS roli
PLATFORM_DATABASE_URL=postgresql+asyncpg://playbron_platform:platform@localhost:5432/playbron

# Migratsiya rollarni shu parollar bilan yaratadi
APP_DB_PASSWORD=app
PLATFORM_DB_PASSWORD=platform

REDIS_URL=redis://localhost:6379/0

# ── Telegram ──────────────────────────────────────────────────────────────
# @BotFather dan olinadi
BOT_TOKEN=
ADMIN_BOT_TOKEN=
# setWebhook uchun tasodifiy satr
TG_WEBHOOK_SECRET=

INITDATA_TTL_SEC=300
WIDGET_TTL_SEC=86400

# ── Sessiya ───────────────────────────────────────────────────────────────
# Prod'da majburiy: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# ── Biznes qoidalari ──────────────────────────────────────────────────────
GRACE_DAYS=3
SUBSCRIPTION_WARN_DAYS=3

# ── Super admin ───────────────────────────────────────────────────────────
# Vergul bilan ajratilgan telegram_id lar. Seed shundan o'qiydi.
SUPER_ADMIN_TELEGRAM_IDS=
# Bo'sh — cheklovsiz. Prod'da to'ldiriladi.
PLATFORM_IP_ALLOWLIST=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
