---
import { LAUNCH_YEAR, LEGAL_ENTITY, SITE } from '../config';
import type { Content, Lang } from '../content';
import Wordmark from './Wordmark.astro';

interface Props {
  c: Content;
  lang: Lang;
}

const { c, lang } = Astro.props;
const f = c.footer;

// Build yilidan hisoblanadi — statik sayt har deployda qayta yig'iladi
const buildYear = new Date().getFullYear();
const years = buildYear > LAUNCH_YEAR ? `${LAUNCH_YEAR}–${buildYear}` : String(LAUNCH_YEAR);
---

<footer class="pbl-footer">
  <div class="pbl-wrap">
    <div class="pbl-footer__grid">
      <div class="pbl-footer__brand">
        <Wordmark />
        <p>{f.tagline}</p>
      </div>

      <div>
        <h4>{f.productTitle}</h4>
        <ul>
          <li><a class="pbl-link" href="#imkoniyatlar">{c.nav.features}</a></li>
          <li><a class="pbl-link" href="#ekranlar">{c.nav.screens}</a></li>
          <li><a class="pbl-link" href="#tariflar">{c.nav.pricing}</a></li>
          <li><a class="pbl-link" href="#savollar">{c.nav.faq}</a></li>
        </ul>
      </div>

      <div>
        <h4>{f.playersTitle}</h4>
        <ul>
          <li><a class="pbl-link" href={SITE.customerBot}>{f.telegram}</a></li>
          <li><a class="pbl-link" href={SITE.miniapp}>{f.miniapp}</a></li>
        </ul>
      </div>

      <div>
        <h4>{f.companyTitle}</h4>
        <ul>
          <li><a class="pbl-link" href={SITE.consoleWithLang(SITE.console, lang)}>{f.console}</a></li>
          <li><a class="pbl-link" href={SITE.appBot}>{f.telegram}</a></li>
          <li><a class="pbl-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="pbl-link" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="pbl-footer__bar">
      {/* Yil build paytida hisoblanadi: har deployda o'zi yangilanadi va
          «© 2026» bo'lib qotib qolmaydi. Bir yildan oshsa oraliq ko'rsatiladi. */}
      <span>© {years} PlayBron{LEGAL_ENTITY ? `, ${LEGAL_ENTITY}` : ''}</span>
      {/* «Barcha huquqlar himoyalangan» ATAYLAB yo'q: bu ibora bugungi
          huquqda hech narsa qo'shmaydi (Buenos-Ayres konvensiyasi eskirgan),
          domen nomini takrorlash ham ortiqcha — u yuqorida allaqachon bor. */}
      <span>{f.legalNote}</span>
    </div>
  </div>
</footer>
