---
/**
 * Xodim konsoli — jonli board. Rasm emas, haqiqiy HTML: har qanday kenglikda
 * aniq ko'rinadi va tokenlar o'zgarsa mahsulot bilan birga o'zgaradi.
 */
import type { Content, StationState } from '../../content';
import Icon from '../Icon.astro';
import Wordmark from '../Wordmark.astro';

interface Props {
  c: Content;
}

const { c } = Astro.props;
const b = c.screens.board;

/**
 * Ikonka — matn emas, shuning uchun i18n resursida emas, shu yerda.
 * `apps/admin/src/mock/data.ts::NAV_STAFF` bilan bir xil tartibda.
 */
const NAV_ICONS = [
  'grid_view',
  'calendar_view_week',
  'receipt_long',
  'event_available',
  'point_of_sale',
  'savings',
  'person_off',
];

const STATE_LABEL: Record<StationState, string> = {
  free: b.statusFree,
  busy: b.statusBusy,
  maintenance: b.statusMaintenance,
};
---

<div class="pbl-app">
  <div class="pbl-app__bar">
    <span class="pbl-app__dots"><i></i><i></i><i></i></span>
    <span class="pbl-app__url">playbron.uz/board</span>
  </div>

  <div class="pbl-app__body">
    <nav class="pbl-app__nav" aria-hidden="true">
      <div class="pbl-app__brand">
        <Wordmark title="" />
        <span>{b.brandRole}</span>
      </div>
      <ul>
        {
          b.nav.map((item, index) => (
            <li data-on={index === 0 ? '' : undefined}>
              <Icon name={NAV_ICONS[index] ?? 'circle'} size="sm" />
              {item}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="pbl-app__main">
      <div>
        <div class="pbl-app__title">{b.pageTitle}</div>
        <div class="pbl-app__meta">{b.meta.map((item) => <span>{item}</span>)}</div>
      </div>

      <div class="pbl-kpis">
        {
          b.metrics.map((metric) => (
            <div class="pbl-kpi">
              <span>{metric.label}</span>
              <b>{metric.value}</b>
            </div>
          ))
        }
      </div>

      <div class="pbl-stations">
        {
          b.stations.map((station) => (
            <div class="pbl-station" data-state={station.state}>
              <div class="pbl-station__top">
                <span class="pbl-station__name">{station.name}</span>
                <span class="pbl-station__state">
                  <i></i>
                  {STATE_LABEL[station.state]}
                </span>
              </div>
              <span class="pbl-station__room">{station.meta}</span>
              <span class="pbl-station__divider" aria-hidden="true"></span>
              {station.guestLine ? (
                <span class="pbl-station__guest">{station.guestLine}</span>
              ) : station.state === 'maintenance' ? (
                <span class="pbl-station__guest">—</span>
              ) : (
                <span class="pbl-station__cta">{b.openAction}</span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
