---
import { SITE } from '../../config';
import type { Content, Lang } from '../../content';
import Icon from '../Icon.astro';

interface Props {
  c: Content;
  lang: Lang;
}

const { c, lang } = Astro.props;
const t = c.cta;
---

<section class="pbl-section" id="boshlash">
  <div class="pbl-wrap">
    <div class="pbl-cta">
      <span class="pbl-eyebrow">{t.eyebrow}</span>
      <h2 class="pbl-h2">{t.title}</h2>
      <p class="pbl-lead">{t.text}</p>

      <div class="pbl-actions">
        <a class="pbl-btn pbl-btn--primary" href={SITE.consoleWithLang(SITE.signup, lang)}>
          <Icon name="how_to_reg" size="sm" />
          {t.primary}
        </a>
        <a class="pbl-btn pbl-btn--ghost" href={SITE.consoleWithLang(SITE.console, lang)}>
          <Icon name="login" size="sm" />
          {t.secondary}
        </a>
        <a class="pbl-btn pbl-btn--ghost" href={SITE.appBot}>
          <Icon name="send" size="sm" />
          {t.tertiary}
        </a>
      </div>

      <p class="pbl-cta__note">{t.note}</p>
    </div>
  </div>
</section>
