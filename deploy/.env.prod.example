# PlayBron — production muhit o'zgaruvchilari (Hetzner VPS).
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod
#
# BU FAYL GIT'GA TUSHMAYDI (`.gitignore`). Ichida barcha sirlar bor.
#
# Tasodifiy qiymat yasash:
#   openssl rand -hex 32

# ── Asosiy ────────────────────────────────────────────────────────────────
ENV=prod
DEBUG=false

# ── Baza ──────────────────────────────────────────────────────────────────
# Uchta ALOHIDA rol ishlatiladi. Render bepul rejasida bitta rol edi va
# shu sababli `ALLOW_SINGLE_DB_ROLE=1` kerak bo'lgan; o'z serverimizda
# bunga hojat YO'Q va uni QO'YMANG — aks holda `staff_credentials`
# ilova rolidan yashirilmay qoladi.
DB_NAME=playbron
DB_OWNER=playbron

# Ega roli paroli (migratsiya va zaxira shu bilan yuradi)
DB_OWNER_PASSWORD=

# Ilova roli (`playbron_app`) — RLS ostida ishlaydi
APP_DB_PASSWORD=

# Platforma roli (`playbron_platform`) — BYPASSRLS, super admin o'qishlari
PLATFORM_DB_PASSWORD=

# ── Sirlar ────────────────────────────────────────────────────────────────
# JWT imzo kaliti. O'ZGARTIRILSA barcha sessiyalar bekor bo'ladi.
JWT_SECRET=

# Telegram webhook sekreti — bu qiymat `setWebhook` da o'rnatiladi va
# har bir kelgan so'rovda tekshiriladi.
TG_WEBHOOK_SECRET=

# ── Telegram botlari ──────────────────────────────────────────────────────
# @BotFather'dan. Ikkalasi HAR XIL bot bo'lishi SHART — bir xil bo'lsa
# ikkinchi `setWebhook` birinchisini bosib ketadi va bitta bot ishlamay
# qoladi (`main.py` lifespan ketma-ket ikkalasini ro'yxatdan o'tkazadi).
BOT_TOKEN=
ADMIN_BOT_TOKEN=

# ── Super admin ───────────────────────────────────────────────────────────
SUPER_ADMIN_TELEGRAM_IDS=611207125
SUPER_ADMIN_LOGINS=istamoffx

# Faqat parolni O'RNATISH/almashtirish kerak bo'lganda to'ldiring.
# Ishlatib bo'lgach BU QATORNI BO'SHATING va `deploy.sh` ni qayta
# yurgizing — aks holda parol serverdagi faylda ochiq turaveradi.
# Standart yo'l: `api/scripts/set_staff_password.py` (parol stdin'dan).
SUPER_ADMIN_PASSWORD=

# ── Manzillar ─────────────────────────────────────────────────────────────
# Telegram webhook SHU manzilga ro'yxatdan o'tadi.
PUBLIC_URL=https://api.playbron.uz

# Frontend qaysi manzillardan API'ga murojaat qila oladi.
CORS_ORIGINS=https://playbron.uz,https://www.playbron.uz,https://app.playbron.uz,https://mini.playbron.uz

# Let's Encrypt bildirishnomalari (sertifikat muddati tugashi va h.k.)
ACME_EMAIL=designerwebapk@gmail.com

# ── Biznes qoidalari ──────────────────────────────────────────────────────
GRACE_DAYS=3
SUBSCRIPTION_WARN_DAYS=3

# ── Frontend build (VITE_* build paytida kodga singdiriladi) ──────────────
VITE_API_URL=https://api.playbron.uz/api/v1
VITE_LANDING_URL=https://playbron.uz
SITE_URL=https://playbron.uz

# ── Deploy ────────────────────────────────────────────────────────────────
# Docker image tegi. `deploy.sh` uni git commit'idan yasaydi.
IMAGE_TAG=latest
