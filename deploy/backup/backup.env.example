# PlayBron zaxira sozlamalari.
#
#   cp backup.env.example /etc/playbron/backup.env
#   chmod 600 /etc/playbron/backup.env      # ichida sirlar bor
#
# Har bir qiymat `playbron-backup.sh` tomonidan o'qiladi.

# ── Baza ──────────────────────────────────────────────────────────────────
# Loyiha `docker compose` bilan turgan papka (ichida docker-compose.yml).
COMPOSE_DIR=/opt/playbron

# Postgres konteyneri servis nomi (docker-compose.yml dagi).
DB_SERVICE=postgres

# MUHIM: bu rol SUPERUSER (yoki BYPASSRLS) bo'lishi SHART.
#
# Loyiha jadvallarida `FORCE ROW LEVEL SECURITY` yoqilgan va u jadval
# EGASIGA HAM tegishli. `pg_dump` ma'lumotni o'qish uchun
# `SET row_security = off` qiladi, buni esa faqat superuser/BYPASSRLS
# qila oladi. Oddiy `playbron_app` roli bilan zaxira quyidagicha
# YIQILADI (sinab ko'rilgan, 2026-08-17):
#
#   pg_dump: error: query failed: ERROR: query would be affected by
#   row-level security policy for table "users"
#
# Ya'ni bo'sh zaxira EMAS — ochiq xato. Lekin baribir zaxira bo'lmaydi.
# `docker-compose.yml` dagi `POSTGRES_USER` konteyner klasterining
# superuseri — o'shani yozing.
DB_SUPERUSER=playbron
DB_NAME=playbron

# ── Saqlash joyi ──────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/playbron

# Nechta nusxa saqlanadi (kunlik/haftalik/oylik).
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# ── Tashqi nusxa (JUDA MUHIM) ─────────────────────────────────────────────
# Serverning O'ZIDAGI zaxira — zaxira EMAS. Disk ishdan chiqsa yoki
# server o'chirilsa, u ham ketadi. Hetzner Storage Box arzon (~€3.20/oy)
# va shu vazifa uchun aynan mos.
#
# Bo'sh qoldirilsa skript OGOHLANTIRADI, lekin ishlayveradi.
#
# Namuna: u123456@u123456.your-storagebox.de:/home/playbron
REMOTE_TARGET=
# SSH kaliti (parolsiz, faqat shu vazifa uchun yaratilgan)
REMOTE_SSH_KEY=/root/.ssh/playbron_backup
REMOTE_SSH_PORT=23

# ── Shifrlash (ixtiyoriy, lekin tavsiya etiladi) ──────────────────────────
# Zaxirada mijoz ismi va telefon raqami bor. Tashqariga chiqarilsa
# shifrlangani ma'qul. `age` o'rnatilgan bo'lsa va ochiq kalit berilsa,
# fayl yuborishdan oldin shifrlanadi.
#
#   age-keygen -o /root/.config/playbron-age.key
#   # chiqqan "Public key: age1..." ni shu yerga yozing
#
# DIQQAT: maxfiy kalitni YO'QOTSANGIZ zaxirani ochib bo'lmaydi.
# Uni serverdan TASHQARIDA ham saqlang.
AGE_PUBLIC_KEY=

# ── Xabar berish ──────────────────────────────────────────────────────────
# Zaxira YIQILSA darhol Telegram'ga xabar ketadi. Mavjud admin botdan
# foydalaniladi — yangi narsa kerak emas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# `1` bo'lsa muvaffaqiyatli zaxira haqida ham kuniga bir marta xabar
# keladi ("jim qolgan zaxira" ni sezish uchun foydali).
NOTIFY_ON_SUCCESS=0
