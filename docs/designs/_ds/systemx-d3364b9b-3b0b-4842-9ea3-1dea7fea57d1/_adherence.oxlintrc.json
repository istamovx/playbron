{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/charts/**",
              "components/data/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/primitives/**",
              "components/surfaces/**",
              "ui_kits/soc-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Chakra Petch|JetBrains Mono|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Chakra Petch, JetBrains Mono, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionItemCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:relatedTo|title|emphasis|actions|onView|onAction|style|key|ref|className|style|children)$/]",
        "message": "<ActionItemCard> doesn't accept that prop. Declared props: relatedTo, title, emphasis, actions, onView, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:seed|bars|height|labels|style|key|ref|className|style|children)$/]",
        "message": "<ActivityBars> doesn't accept that prop. Declared props: seed, bars, height, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaTrend'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|seed|points|height|tone|labels|fill|dots|compact|hover|formatValue|style|key|ref|className|style|children)$/]",
        "message": "<AreaTrend> doesn't accept that prop. Declared props: values, seed, points, height, tone, labels, fill, dots, compact, hover, formatValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|square|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, square, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|block|disabled|notch|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, block, disabled, notch, onClick, style."
      },
      {
